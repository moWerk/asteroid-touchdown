[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-asteroid-touchdown
Exec=sailfish-qml harbour-asteroid-touchdown
Name=Touchdown
Comment=A tilt controlled lunar lander

[X-Sailjail]
# Sandboxed. The game reads the accelerometer (Sensors) and writes only
# its own config directory, ~/.config/net.mowerk/harbour-asteroid-touchdown/.
OrganizationName=net.mowerk
ApplicationName=harbour-asteroid-touchdown
Permissions=Sensors
